# Copy to .env and adjust if needed. All values have working local defaults -
# the app runs with zero configuration out of the box.

# APP_NAME="Portfolio Management API"
# API_PREFIX=/api
# CORS_ORIGINS=["http://localhost:5173"]

# SQLite by default. To move to Postgres later:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/portfolio
# DATABASE_URL=sqlite:///./portfolio.db

# AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt

# Bootstrap logins, created by the auth migration / `python -m scripts.seed`.
# Set real passwords here BEFORE the first migration on an internet-facing server.
# SEED_USER_EMAIL=aggarwal_ashutosh@yahoo.com
# SEED_USER_NAME=Ashutosh Aggarwal
# SEED_USER_PASSWORD=password@123
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=password@123
# Token signing key; leave unset to auto-generate backend/.auth_secret
# AUTH_SECRET=
