# Copy to .env and adjust if needed. All values have working local defaults -
# the app runs with zero configuration out of the box.

# APP_NAME="Portfolio Management API"
# API_PREFIX=/api
# CORS_ORIGINS=["http://localhost:5173"]

# SQLite by default. To move to Postgres later:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/portfolio
# DATABASE_URL=sqlite:///./portfolio.db

# AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVAll.txt

# SEED_USER_EMAIL=owner@portfolio.local
# SEED_USER_NAME=Portfolio Owner
